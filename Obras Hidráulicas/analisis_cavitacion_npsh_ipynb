        "carga_presion_neta = (P_atm - P_v) / gamma\n",
        "k_s = (8 * f_s * L_s) / (np.pi**2 * g * D_s**5)\n",
        "hf_s_array = k_s * (Q_array**2)\n",
        "NPSHr_array = NPSH_r_funcion(Q_array)\n",
        "delta_z_array = carga_presion_neta - hf_s_array - NPSHr_array\n",
        "\n",
        "\n",
        "plt.figure(figsize=(10, 6))\n",
        "plt.plot(Q_array*3600, delta_z_array, 'b-', linewidth=2.5)\n",
        "plt.title(\"Altura Máxima de Succión (Δz) vs. Caudal (Q)\\n(Rango de eficiencia η > 75%)\", fontsize=14)\n",
        "plt.xlabel(\"Caudal Máximo (Q_max) [m³/h]\", fontsize=12)\n",
        "plt.ylabel(\"Altura Máxima de Succión (Δz = $z_2 - z_1$) [m]\", fontsize=12)\n",
        "plt.grid(True, which='both', linestyle='--', linewidth=0.5)\n",
        "plt.xlim((Qminimo_efi_75, Qmaximo_efi_75))\n",
        "\n",
        "plt.axhline(0, color='k', linestyle=':', linewidth=1.0, label=\"Nivel del estanque (z_1)\")\n",
        "\n",
        "plt.legend()\n",
        "plt.show()"
